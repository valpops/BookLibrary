@model BookLibrary.Models.BookInputModel

@* Shared by Create and Edit so the two forms can never drift apart.
   The data-val-* attributes on these inputs are generated by FluentValidation's
   client-side adapters from BookInputModelValidator - there are no validation
   attributes written here by hand. *@

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" autocomplete="off" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Genre" class="form-label"></label>
        <select asp-for="Genre" class="form-select">
            <option value="">Choose a genre</option>
            @foreach (var genre in BookLibrary.Validators.BookInputModelValidator.Genres)
            {
                <option value="@genre">@genre</option>
            }
        </select>
        <span asp-validation-for="Genre" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Author" class="form-label"></label>
        <input asp-for="Author" class="form-control" autocomplete="off" />
        <span asp-validation-for="Author" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Isbn" class="form-label"></label>
        <input asp-for="Isbn" class="form-control" autocomplete="off"
               placeholder="978-0-306-40615-7" />
        <span asp-validation-for="Isbn" class="text-danger small"></span>
        <div class="form-text">
            10 or 13 digits. The check digit is verified when you save.
        </div>
    </div>

    <div class="col-md-4">
        <label asp-for="PublishedOn" class="form-label"></label>
        @* An <input type="date"> only prefills if the value is exactly
           yyyy-MM-dd, so the format is pinned rather than left to the culture. *@
        <input asp-for="PublishedOn" class="form-control" type="date"
               asp-format="{0:yyyy-MM-dd}" />
        <span asp-validation-for="PublishedOn" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PageCount" class="form-label"></label>
        <input asp-for="PageCount" class="form-control" type="number" min="1" />
        <span asp-validation-for="PageCount" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
</div>
