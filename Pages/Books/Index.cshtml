@page
@model BookLibrary.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Books</h1>
    <a asp-page="./Create" class="btn btn-primary">Add a book</a>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-sm-6 col-md-4">
        <input type="search" name="search" value="@Model.Search" class="form-control"
               placeholder="Search by title, author, or ISBN" aria-label="Search books" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="col-auto">
            <a asp-page="./Index" class="btn btn-link">Clear</a>
        </div>
    }
</form>

@if (!Model.Books.Any())
{
    <div class="border rounded p-5 text-center text-muted">
        @if (string.IsNullOrWhiteSpace(Model.Search))
        {
            <p class="mb-3">No books in the library yet.</p>
            <a asp-page="./Create" class="btn btn-primary">Add the first one</a>
        }
        else
        {
            <p class="mb-3">Nothing matches &ldquo;@Model.Search&rdquo;.</p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Show all books</a>
        }
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>Genre</th>
                <th>ISBN</th>
                <th class="text-end">Published</th>
                <th class="text-end">Pages</th>
                <th class="text-end">Price</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.Author</td>
                <td><span class="badge text-bg-light">@book.Genre</span></td>
                <td><code>@book.Isbn</code></td>
                <td class="text-end">@book.PublishedOn.ToString("d MMM yyyy")</td>
                <td class="text-end">@book.PageCount</td>
                <td class="text-end">@book.Price.ToString("C")</td>
                <td class="text-end text-nowrap">
                    <a asp-page="./Edit" asp-route-id="@book.Id"
                       class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="./Delete" asp-route-id="@book.Id"
                       class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

}
